meta {
  name: Reset Password
  type: http
  seq: 4
}

post {
  url: {{host}}/api/auth/reset-password
  body: json
  auth: none
}

body:json {
  {
    "token": "your-reset-token-here",
    "password": "NewPassword123!",
    "userType": "admin",
    "userId": "your-user-id-here"
  }
}

tests {
  test("should reset password successfully with valid token", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.have.property('message');
  });
  
  test("should return error for invalid token", function() {
    if (res.getStatus() === 401) {
      expect(res.getBody()).to.have.property('error');
    }
  });
}
