meta {
  name: Forgot Password
  type: http
  seq: 3
}

post {
  url: {{host}}/api/auth/forgot-password
  body: json
  auth: none
}

body:json {
  {
    "email": "admin@example.com"
  }
}

tests {
  test("should return success for valid email", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.have.property('message');
  });
  
  test("should return error for invalid email", function() {
    if (res.getStatus() === 404) {
      expect(res.getBody()).to.have.property('error');
    }
  });
}
