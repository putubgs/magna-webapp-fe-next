meta {
  name: Create Event
  type: http
  seq: 1
}

post {
  url: {{BASE_URL}}/event
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{ADMIN_TOKEN}}
  ~Authorization: Bearer {{SUPERADMIN_TOKEN}}
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

body:json {
  {
    "organization_id": "d0961f11-3766-4143-a949-e6566e179bb7",
    "event_poster_url": "https://example.com/event-image.jpg",
    "title": "Workshop React JS: From Zero to Hero",
    "description": "Workshop pembelajaran React JS dari dasar untuk pemula, mencakup konsep komponen, hooks, dan integrasi API.",
    "gform_link": "https://forms.gle/123",
    "registration_deadline": "2025-06-01T15:00:00Z",
    "event_start_date": "2025-06-10T09:00:00Z",
    "event_end_date": "2025-06-10T17:00:00Z"
  }
  
}
